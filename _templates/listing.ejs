<% for (const [category, items] of Object.entries(categories)) { %>
<h3><%= category %></h3>
<ul class="list-unstyled">
<% items.forEach(item => { %>
<li>
<a href="<%- item.path %>">
<h4><%= item.title %></h4>
</a>
<div class="badges-container">
<% if (item.type) { %>
<p><img src="https://img.shields.io/badge/<%= item.type %>-B31212" alt="<%= item.type %>"></p>
<% } %>
<% if (item.skills) { %>
<% item.skills.forEach(skill => { %>
<% const skillKey = skill.toLowerCase(); %>
<% const badgeUrl = badges[skillKey] || `https://img.shields.io/badge/${encodeURIComponent(skill)}-white`; %>
<img src="<%- badgeUrl %>" alt="<%= skill %>">
<% }); %>
<% } %>
</div>
<p><%= item.description %></p>
</li>
<% }); %>
</ul>
<% } %>
